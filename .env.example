# Copy to .env for local development. Do not commit real credentials here.
TEVARTA_ENV=development
TEVARTA_CREDENTIAL_SET=development
TEVARTA_MOCK_ACCESS_TOKEN=fixture-access-token
TEVARTA_REDIS_URL=redis://localhost:6379/0
TEVARTA_POSTGRES_URL=postgresql://localhost/tevarta_dev
TEVARTA_NEO4J_URL=neo4j://localhost:7687
TEVARTA_R2_BUCKET=tevarta-dev
# Operations contact sent in the declared User-Agent; SEC rejects undeclared clients.
TEVARTA_HTTP_CONTACT=
# Set these only through the managed secret store outside local fixture mode.
TEVARTA_APPLE_CLIENT_ID=
TEVARTA_JWT_SIGNING_KEY=
TEVARTA_REFRESH_TTL_SECONDS=
# Curated-edge tooling (scripts/curate_edges.py). Drafting has no model default and
# refuses to run until the model ID and its current token prices are set.
OPENAI_API_KEY=
TEVARTA_CURATION_DRAFT_MODEL=
TEVARTA_CURATION_DRAFT_USD_PER_MTOK_INPUT=
TEVARTA_CURATION_DRAFT_USD_PER_MTOK_OUTPUT=
TEVARTA_NEO4J_PASSWORD=
# true rejects Apple sign-in without a client nonce; enable once the iOS client sends one.
TEVARTA_REQUIRE_APPLE_NONCE=false
# Search (T19): the one provider is Brave News Search; unset keeps search off.
TEVARTA_SEARCH_PROVIDER=
BRAVE_SEARCH_API_KEY=
