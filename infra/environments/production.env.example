# Set these through the managed secret store; do not copy real values here.
TEVARTA_ENV=production
TEVARTA_CREDENTIAL_SET=production
TEVARTA_POSTGRES_URL=<managed-production-postgres-url>
TEVARTA_NEO4J_URL=<managed-production-neo4j-url>
TEVARTA_R2_BUCKET=<production-private-r2-bucket>
TEVARTA_APPLE_CLIENT_ID=<ios-bundle-client-id>
TEVARTA_JWT_SIGNING_KEY=<managed-32-plus-character-signing-key>
TEVARTA_REFRESH_TTL_SECONDS=<founder-approved-refresh-session-lifetime>
